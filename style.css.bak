* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Outfit', sans-serif;
    /* Из вашего скриншота */
    color: #1D2128;
}

.container {
    max-width: 1680px;
    margin: 0 auto;
    position: relative;
    min-height: 1020px;
}

.hero {
    position: relative;
    height: 1020px;
    margin: 0 auto 120px;
    max-width: 1920px;
    /* Высота из макета */
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

/* Фоновая картинка */
.hero__bg-img {
    position: absolute;
    top: 0;
    right: 0;
    width: 1090px;
    height: 1020px;
    object-fit: cover;
    z-index: 1;
}

.header {
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 84px;
}

.nav__list {
    display: flex;
    list-style: none;
    gap: 32px;
}

.nav__link {
    text-decoration: none;
    color: #1D2128;
    font-size: 14px;
    font-weight: 500;
    transition: opacity 0.3s;
}

.nav__link:hover {
    border-bottom: 1px solid #052838;
}

.nav__link_active {
    border-bottom: 1px solid #052838;
}

.phone-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #1D2128;
    color: #FFF;
    text-decoration: none;
    padding: 10px 24px;
    border-radius: 100px;
    font-weight: 600;
    font-size: 16px;
}

.phone-btn:hover {
    background-color: #073d57;
}

.hero__content {
    position: relative;
    z-index: 5;
    max-width: 788px;
    padding-top: 280px;
}

.hero__text-block {
    max-width: 788px;
}

.hero__title {
    margin: 0;
    color: var(--Brand-Primary, #052838);
    font-size: 100px;
    font-style: normal;
    font-weight: 700;
    line-height: 110px;
    /* 110% */
    margin-bottom: 20px;
}

.hero__descr {
    font-size: 20px;
    line-height: 1.5;
    color: #4A4E56;
    margin-bottom: 40px;
    max-width: 600px;
}

.btn-primary {
    display: flex;
    width: 260px;
    padding: 16px 24px;
    justify-content: center;
    align-items: center;
    gap: 12px;
    color: var(--Grayscale-000, #FFF);
    text-align: center;
    font-feature-settings: 'liga' off, 'clig' off;
    border-radius: 12px;
    background: var(--Brand-Primary, #052838);
    font-size: 16px;
    font-style: normal;
    font-weight: 600;
    line-height: 24px;
    transition: all 0.3s ease-in-out;
    text-decoration: none;
}

.btn-primary:hover {
    background-color: #073d57;
}

:root {
    --brand-primary: hsla(199, 91%, 22%, 1);
    --text-secondary: #4A4A4A;
    --white: #FFFFFF;
}

.container {
    max-width: 1680px;
    margin: 0 auto;
    padding: 120px 20px;
}

:root {
    --primary-color: #0B222E;
    /* Из макета hsba(199, 91%, 22%) */
    --text-main: #0B222E;
    --text-secondary: #4A5568;
    --font-family: 'Outfit', sans-serif;
}

bout-section {
    width: 100%;
    padding: 120px 0;
    display: flex;
    justify-content: center;
}

.container {
    max-width: 1920px;
    width: 100%;
    padding: 0 120px;
}

.content-wrapper {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 80px;
}

.text-content {
    flex: 1;
    max-width: 788px;
    display: flex;
    flex-direction: column;
    gap: 28px;
}

.title {
    font-size: 64px;
    font-weight: 700;
    line-height: 1;
    color: #0A2533;
}

.description {
    font-size: 20px;
    font-weight: 400;
    line-height: 32px;
    color: #333333;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.btn {
    display: flex;
    width: 260px;
    padding: 16px 24px;
    justify-content: center;
    align-items: center;
    gap: 12px;
    color: var(--Grayscale-000, #FFF);
    text-align: center;
    font-feature-settings: 'liga' off, 'clig' off;
    border-radius: 12px;
    background: var(--Brand-Primary, #052838);
    font-size: 16px;
    font-style: normal;
    font-weight: 600;
    line-height: 24px;
    transition: all 0.3s ease-in-out;
    text-decoration: none;
}

.btn:hover {
    background-color: #073d57;
}

.image-content {
    flex-shrink: 0;
}

.image-content img {
    width: 828px;
    height: 600px;
    object-fit: cover;
    border-radius: 12px;
    display: block;
}

@media (max-width: 1200px) {

    .content-wrapper {

        flex-direction: column;

        align-items: center;

        gap: 40px;

    }

    .container {

        padding: 0 40px;

    }

    .image-content img {

        width: 100%;

        height: auto;

    }

    .about-section {

        padding: 60px 0;

    }

}

/* Адаптивность для мобильных устройств */
@media (max-width: 1200px) {
    .content-wrapper {
        flex-direction: column;
        align-items: center;
        gap: 40px;
    }

    .container {
        padding: 0 40px;
    }

    .image-content img {
        width: 100%;
        height: auto;
    }

    .about-section {
        padding: 60px 0;
    }
}


.portfolio {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
}

.portfolio .container {
    position: relative;
}

.container {
    max-width: 1680px;
    margin: 0 auto;
    padding: 0 20px;
    height: 924px;
}

.portfolio__header {
    margin-bottom: 60px;
}

.portfolio__title {
    font-size: 64px;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 24px;
    color: var(--text-main);
}

.portfolio__description {
    font-size: 16px;
    line-height: 24px;
    max-width: 700px;
    color: var(--text-secondary);
}

.portfolio__slider-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
    overflow: visible;
    min-height: 544px;
}

.portfolio__slider-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 24px;
    width: 100%;
    min-height: 544px;
}

.portfolio__slider {
    display: flex;
    gap: 24px;
    align-items: center;
}

.portfolio__slider {
    display: flex;
    transition: transform 0.5s ease-in-out;
}

.portfolio__card {
    height: 544px;
    width: 544px;
    position: relative;
    border-radius: 24px;
    overflow: hidden;
}

.portfolio__card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.portfolio__card-content {
    position: absolute;
    bottom: 0;
    width: 100%;
    padding-top: 20px;
    padding-left: 24px;
    padding-right: 24px;
    background: var(--Brand-primary, #052838);
    height: 144px;
}

.portfolio__card-content:hover {
    background-color: #073d57;
}

.portfolio__card-title {
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 8px;
    color: var(--white, #FFFFFF);
}

.portfolio__card-text {
    font-size: 16px;
    color: var(--Grayscale-300, #D7DAE2);
    margin-top: 8px;
    font-family: Outfit;
    font-style: normal;
    font-weight: 400;
    line-height: 24px;

}

.portfolio__arrow {
    width: 64px;
    height: 64px;
    background-color: var(--primary-color);
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: opacity 0.3s;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    padding: 8px;
}

.portfolio__arrow_prev {
    left: -48px;
    right: auto;
}

.portfolio__arrow_next {
    right: -48px;
    left: auto;
}

.portfolio__arrow_prev svg,
.portfolio__arrow_next svg {
    width: 24px;
    height: 24px;
    display: block;
}

.portfolio__arrow_prev svg {
    transform: none;
}

.portfolio__arrow_next svg {
    transform: rotate(180deg);
}

.portfolio__arrow:hover {
    opacity: 0.9;
}

.portfolio__link {
    background-color: var(--primary-color);
    color: #fff;
    padding: 12px 24px;
    border-radius: 4px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
}

.portfolio-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 1680px;
    margin: 40px auto 0;
}

.portfolio-cta {
    position: absolute;
    right: 20px;
    bottom: 20px;
}

.pagination {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'Outfit', sans-serif;
}

.current {
    font-weight: 700;
    font-size: 18px;
    color: #052D40;
}

.total {
    font-size: 14px;
    color: #A0A0A0;
    margin-left: -8px;
}

.progress-bar {
    width: 300px;
    height: 2px;
    background-color: #E0E0E0;
    position: relative;
}

.progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 50%;
    height: 100%;
    background-color: #052D40;
    transition: width 0.3s ease;
}

.view-portfolio-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    background-color: #052D40;
    color: #ffffff;
    padding: 16px 24px;
    border-radius: 12px;
    text-decoration: none;
    font-size: 16px;
    transition: 0.3s;
    height: 56px;
}

.view-portfolio-btn:hover {
    background-color: #073d57;
}

.arrow-icon {
    width: 24px;
    height: 24px;
}

.credentials {
    width: 100%;
    max-width: 1920px;
    height: 1160px;
    padding: 120px;
    background: #FFFFFF;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
}

.credentials__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(544px, 1fr));
    gap: 24px;
    width: 100%;
    margin-bottom: 64px;
}

.credentials__header {
    width: 1680px;
    height: 160px;
    /* */
    margin-bottom: 64px;
}

.credentials__title {
    font-size: 64px;
    font-weight: 700;
    color: #1E252D;
    margin-bottom: 24px;
}

.credentials__subtitle {
    max-width: 600px;
    font-size: 16px;
    line-height: 1.5;
    color: #4A4A4A;
}

.credential-card {
    width: 544px;
    height: 280px;
    background: #062542;
    border-radius: 12px;
    padding: 32px;
    position: relative;
    display: flex;
    justify-content: space-between;
    color: #FFFFFF;
    transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
    cursor: pointer;
}

.credential-card:hover {

    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.12);
    background: #073d57;
}

.credential-card__name {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 12px;
}

.credential-card__desc {
    font-size: 14px;
    opacity: 0.7;
    max-width: 240px;
}

.credential-card__year {
    display: block;
    margin-top: 12px;
    font-size: 14px;
    opacity: 0.5;
}

/* Бейдж "Winner" */
.credential-card__badge {
    position: absolute;
    bottom: 32px;
    left: 32px;
    padding: 4px 12px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 4px;
    font-size: 12px;
    text-transform: uppercase;
}

.credential-card__icon {
    align-self: flex-end;
}

.credential-card__icon img {
    width: 88px;
    height: 88px;
}

.credentials__footer {
    width: 1680px;
    display: flex;
    justify-content: flex-end;
    /* Кнопка прижата вправо по макету */
}

.credentials__btn {
    width: 260px;
    height: 56px;
    /* */
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: #1E252D;
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: background 0.3s ease;
}

.credentials__btn:hover {
    background: #073d57;
}

.btn-icon {
    width: 24px;
    height: 24px;
    color: #FFFFFF;
}

.btn-arrow-icon {
    width: 24px;
    height: 24px;
}

:root {
    --bg-dark: #051c2c;
    --text-white: #ffffff;
    --accent-color: #002b44;
}

.partners-section {
    width: 100%;
    padding: 120px 0;
    background: #FFFFFF;
    display: flex;
    justify-content: center;
}

.partners-section .container {
    width: 100%;
    max-width: 1680px;
    display: flex;
    flex-direction: column;
    gap: 60px;
    min-height: 584px;
}

.partners-section .header-group {
    max-width: 840px;
}

.partners-section .title {
    font-size: 64px;
    font-weight: 700;
    line-height: 1.05;
    margin-bottom: 16px;
    color: #0B222E;
}

.partners-section .description {
    max-width: 720px;
    font-size: 16px;
    line-height: 1.75;
    color: #4A5568;
    opacity: 0.9;
}

.project-card {
    width: 100%;
    display: flex;
    justify-content: center;
}

.project-card__image-wrapper {
    position: relative;
    width: 100%;
    min-height: 584px;
    border-radius: 32px;
    overflow: visible;
    background: #000;
}

.project-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 32px;
}

.nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: none;
    background: rgba(5, 40, 56, 0.88);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
}

.nav-btn::before {
    content: "";
    display: block;
    width: 10px;
    height: 10px;
    border-right: 2px solid #FFFFFF;
    border-top: 2px solid #FFFFFF;
}

.nav-btn_prev {
    left: -25px;
}

.nav-btn_prev::before {
    transform: rotate(-135deg);
}

.nav-btn_next {
    right: -25px;
}

.nav-btn_next::before {
    transform: rotate(45deg);
}

.project-card__image-wrapper {
    position: relative;
    width: 100%;
    height: 500px;
    /* Примерная высота с макета */
    border-radius: 20px;
    /* Скругление на макете чуть меньше, чем 32px */
    overflow: visible;
    /* ВАЖНО: меняем на visible, чтобы стрелки не обрезались! */
}

.project-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 20px;
    /* Дублируем скругление здесь */
}

.project-card__overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: auto;
    /* Пусть высота зависит от контента */
    padding: 30px 40px;
    background: rgba(5, 40, 56, 0.85);
    /* Полупрозрачный синий */
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

project-card__content {
    width: 100%;
    padding: 32px 40px;
    box-sizing: border-box;
}

.project-card__content h3 {
    font-size: 28px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 12px;
}

.project-card__content p {
    font-size: 16px;
    line-height: 28px;
    color: rgba(255, 255, 255, 0.92);
    margin: 0;
    max-width: 960px;
}

.slider-footer {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
}

.slider-footer .pagination {
    display: flex;
    align-items: center;
    gap: 14px;
    font-weight: 600;
    color: #052D40;
    margin: 0 auto;
}

.view-portfolio {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    padding: 16px 32px;
    background: #052D40;
    color: #FFFFFF;
    text-decoration: none;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
}

.view-portfolio:hover {
    background: #073d57;
}

.view-portfolio__icon {
    width: 24px;
    height: 24px;
    display: block;
}

.slider-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
}

.slider-footer .pagination {
    display: flex;
    align-items: center;
    gap: 14px;
    font-weight: 600;
    color: #052D40;
}

.slider-footer .current {
    font-size: 18px;
}

.slider-footer .total {
    font-size: 16px;
    color: #4A5568;
}

.slider-footer__progress-bar {
    width: 280px;
    height: 2px;
    background: #E6E7EB;
    border-radius: 1px;
    overflow: hidden;
}

.slider-footer__fill {
    width: 50%;
    height: 100%;
    background: #052D40;
    transition: width 0.3s ease;
}

.view-portfolio {
    padding: 16px 32px;
    background: #052D40;
    color: #FFFFFF;
    text-decoration: none;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
}

.view-portfolio:hover {
    background: #073d57;
}

.faq-section {
    width: 100%;
    max-width: 1920px;
    /* Общая ширина из скриншота 1 */
    margin: 0 auto;
    padding: 100px 120px;
    /* Top: 100, Right/Left: 120 из скриншота 1 */
    box-sizing: border-box;
}

.faq-container {
    width: 1680px;
    /* Fill (1,680px) из скриншота 2 */
    display: flex;
    flex-direction: row;
    /* Horizontal Flow из скриншота 2 */
    gap: 64px;
    /* Gap 64px из скриншота 2 */
    align-items: flex-start;
}

/* Блок заголовка */
.faq-title-block {
    width: 788px;
    /* Fill (788px) из скриншота 7 */
    display: flex;
    flex-direction: column;
    gap: 24px;
    /* Gap 24px из скриншота 7 */
}

.faq-title {
    font-size: 64px;
    /* Примерный размер исходя из веса заголовка */
    line-height: 1.05;
    margin: 0;
    color: #051c2c;
}

/* Блок аккордеона */
.faq-accordion {
    width: 828px;
    /* Fixed (828px) из скриншота 3 */
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.faq-item {
    width: 828px;
    border-bottom: 1px solid #e0e0e0;
    box-sizing: border-box;
}

/* Базовая настройка для всех строк */
.faq-item summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32px 0;
    font-family: 'Outfit', sans-serif;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;
    color: #0B222E;
    cursor: pointer;
}

.faq-item summary::-webkit-details-marker {
    display: none;
}

/* Иконка стрелочки */
.icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    color: #0B222E;
    transform: rotate(0deg);
}

.faq-item[open] .icon {
    transform: rotate(180deg);
}

.faq-item:nth-child(2) {
    margin-bottom: 8px;
}

/* Специфика для ЗАКРЫТЫХ строк */
.faq-item:not([open]) {
    min-height: 96px;
}

/* Специфика для ОТКРЫТОЙ строки */
.faq-item[open] {
    min-height: 168px;
}

.faq-item[open] .faq-content {
    padding-top: 24px;
    font-size: 16px;
    line-height: 28px;
    color: #4A4A4A;
}

:root {
    --bg-dark: #051d29;
    /* Глубокий темно-синий из макета */
    --text-white: #ffffff;
    --input-bg: rgba(255, 255, 255, 0.05);
    --input-border: rgba(255, 255, 255, 0.2);
}

body {
    margin: 0;
    font-family: 'Outfit', sans-serif;
    background-color: #ffffff;
}

/* Обертка для соблюдения размеров 1920×890 */
.cta-wrapper {
    width: 100%;
    max-width: 1920px;
    height: 890px;
    padding: 120px;
    box-sizing: border-box;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent;
}

/* Основной контейнер секции 1680×650 */
.cta-container {
    width: 1680px;
    height: 650px;
    background-color: #051c2c;
    border-radius: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    overflow: hidden;
    color: #ffffff;
    box-sizing: border-box;
    padding: 40px 50px;
}

/* Контентная часть (626×404) */
.cta-content {
    width: 626px;
    min-height: 404px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.cta-heading-box {
    width: 626px;
    height: 128px;
}

.cta-title {
    font-family: 'Outfit', sans-serif;
    font-size: 64px;
    font-weight: 700;
    line-height: 64px;
    margin: 0;
}

.cta-description,
.cta-subtext {
    font-size: 16px;
    line-height: 1.5;
    margin-bottom: 20px;
    opacity: 0.9;
}

.cta-form {
    display: flex;
    gap: 12px;
    margin-top: 32px;
    margin-bottom: 16px;
}

.cta-input {
    flex: 1;
    background: var(--input-bg);
    border: 1px solid var(--input-border);
    border-radius: 8px;
    padding: 16px 20px;
    color: white;
    font-size: 16px;
    outline: none;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

.cta-input::placeholder {
    color: rgba(255, 255, 255, 0.5);
}

.cta-input:hover {
    border-color: #7B92F1;
}

.cta-input:focus {
    border-color: #5566FF;
    box-shadow: 0 0 8px rgba(85, 102, 255, 0.2);
}

.cta-input:invalid:not(:placeholder-shown) {
    border-color: #E57373;
    color: #E57373;
    background: rgba(229, 115, 115, 0.05);

}

.cta-button {
    background-color: white;
    color: var(--bg-dark);
    border: none;
    border-radius: 8px;
    padding: 0 32px;
    font-weight: 600;
    font-size: 16px;
    cursor: pointer;
    transition: background 0.3s ease;
}

.cta-button:hover {
    background-color: #e0e0e0;
}

.cta-footer-text {
    font-size: 11px;
    opacity: 0.6;
    line-height: 1.4;
}

.cta-image-box {
    width: 768px;
    height: 530px;
    flex: 0 0 768px;
}

.cta-image-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 24px;
}

/* Адаптив для мобильных устройств */
@media (max-width: 1024px) {
    .cta-wrapper {
        padding: 40px 20px;
    }

    .cta-container {
        flex-direction: column;
        padding: 40px 24px;
    }

    .cta-content {
        flex: none;
        width: 100%;
    }

    .cta-image-box {
        width: 100%;
        height: 300px;
    }

    .cta-title {
        font-size: 32px;
    }
}

.footer {
    width: 100%;
    max-width: 1920px;
    margin: 0 auto;
    border-top: 1px solid #E0E0E0;
    background-color: #ffffff;
    padding: 100px 120px;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
}

.footer-container {
    width: 100%;
    max-width: 1680px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
}

.footer-brand {
    flex: 0 0 263px;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 20px;
    color: #051d29;
}

.copyright {
    font-size: 14px;
    color: #666;
    margin-bottom: 20px;
}

.social-icons {
    display: flex;
    gap: 16px;
}

.social-icons a {
    transition: opacity 0.3s ease;
}

.social-icons a:hover {
    opacity: 0.6;
}

.footer-nav {
    flex: 0 0 546px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.nav-column {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.nav-column a {
    text-decoration: none;
    color: #051d29;
    font-size: 16px;
    transition: opacity 0.2s;
}

.nav-column a:hover {
    opacity: 0.7;
}

.footer-cta {
    flex: 0 0 547px;
}

.footer-cta h3 {
    font-size: 20px;
    margin: 0 0 12px 0;
    color: #051d29;
}

.footer-cta p {
    font-size: 14px;
    line-height: 1.5;
    color: #666;
    margin-bottom: 24px;
}

.footer-form {
    display: flex;
    gap: 10px;
    height: 44px;
}

.footer-form input {
    flex: 1;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    padding: 0 16px;
    outline: none;
    font-size: 16px;
    background-color: #ffffff;
    transition: border-color 0.2s, box-shadow 0.2s;
}

footer-form input:hover {
    border-color: #7B92F1;
}

.footer-form input:focus {
    border-color: #5566FF;
}

.footer-form input[type="tel"]:invalid:not(:placeholder-shown) {
    border-color: #E57373;
    background-color: #FFF8F8;
    color: #E57373;

}

footer-form input[type="tel"]::placeholder {
    color: #D1D1D1;
}

.footer-form button {
    background-color: #051d29;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 0 24px;
    cursor: pointer;
    font-weight: 600;
}

.footer-form button:hover {
    background-color: #073d57;
}

/* Адаптивность для планшетов и мобилок */
@media (max-width: 1024px) {
    .footer-container {
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .footer-nav {
        flex: none;
        width: 100%;
        justify-items: center;
    }

    .footer-brand,
    .footer-cta {
        flex: none;
        width: 100%;
    }

    .social-icons {
        justify-content: center;
    }
}

@media (max-width: 1024px) {
    .navbar .container {
        justify-content: space-between;
        gap: 16px;
    }

    .nav-toggle-label {
        display: block;
    }

    .nav-menu {
        display: none;
        position: absolute;
        top: 84px;
        right: 20px;
        left: 20px;
        background: #ffffff;
        flex-direction: column;
        gap: 16px;
    }

    padding: 20px;
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
    z-index: 50;
}

.nav-toggle:checked+.nav-toggle-label+.nav-menu {
    display: flex;
}

.nav-menu li {
    width: 100%;
}

.nav-menu a {
    display: block;
    width: 100%;
    padding: 10px 0;
    font-size: 15px;
    color: var(--dark-blue);
}

.hero-body {
    flex-direction: column;
    min-height: auto;
    padding-top: 40px;
    padding-bottom: 40px;
}

.hero-text-block {
    width: 100%;
    max-width: 760px;
}

.hero-text-block h1 {
    font-size: 56px;
    line-height: 1.05;
}

.hero-image-block {
    position: relative;
    width: 100%;
    height: 520px;
    margin-top: 32px;
}

.hero-image-block img {
    border-radius: 24px;
}

@media (max-width: 768px) {
    .navbar {
        height: auto;
        padding: 16px 0;
    }

    .navbar .container {
        flex-wrap: wrap;
        align-items: center;
    }

    .hero-body {
        padding: 0 0 24px;
    }

    .hero-text-block h1 {
        font-size: 42px;
    }

    .hero-text-block p {
        font-size: 16px;
        max-width: 100%;
    }

    .hero-image-block {
        height: 420px;
        margin-top: 24px;
    }

    .cta-container {
        padding: 32px 20px;
    }

    .cta-content,
    .cta-image-box {
        width: 100%;
    }

    .cta-image-box {
        height: 320px;
    }
}

@media (max-width: 425px) {
    .navbar .container {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
    }

    .hero-text-block h1 {
        font-size: 32px;
    }

    .hero-text-block p {
        font-size: 15px;
    }

    .hero-image-block {
        height: 280px;
    }

    .cta-wrapper {
        padding: 24px 16px;
    }

    .cta-container {
        padding: 24px 16px;
        border-radius: 24px;
    }

    .cta-title {
        font-size: 28px;
    }

    .cta-form {
        flex-direction: column;
    }

    .cta-button {
        width: 100%;
    }
}

@media (max-width: 768px) {

    /* PORTFOLIO */
    .portfolio .container {
        height: auto;
        padding: 40px 20px;
    }

    .portfolio__slider-wrapper {
        min-height: auto;
    }

    .portfolio__slider-row {
        min-height: auto;
        overflow: hidden;
    }

    .portfolio__slider {
        gap: 12px;
    }

    .portfolio__card {
        width: 260px;
        height: 340px;
        flex-shrink: 0;
    }

    .portfolio__arrow_prev {
        left: -16px;
    }

    .portfolio__arrow_next {
        right: -16px;
    }

    .portfolio-cta {
        position: static;
        margin-top: 24px;
    }

    /* CERTIFICATIONS */
    .credentials {
        height: auto;
        padding: 60px 20px;
        overflow: hidden;
    }

    .credentials__container {
        width: 100%;
        overflow: hidden;
    }

    .credentials__header {
        width: 100%;
        height: auto;
        margin-bottom: 32px;
    }

    .credentials__title {
        font-size: 36px;
    }

    .credentials__grid {
        grid-template-columns: 1fr;
        gap: 16px;
        margin-bottom: 32px;
        position: relative;
        z-index: 0;
    }

    .credential-card {
        width: 100%;
        height: auto;
        min-height: 200px;
        padding: 24px;
        position: relative;
        z-index: 0;
    }

    .credentials__footer {
        width: 100%;
        justify-content: center;
        position: relative;
        z-index: 0;
    }

    /* PARTNERS */
    .partners-section {
        position: relative;
        z-index: 0;
    }

    .partners-section .container {
        padding: 40px 20px;
        gap: 32px;
    }

    .partners-section .title {
        font-size: 36px;
    }

    .project-card__image-wrapper {
        height: 320px;
        border-radius: 20px;
    }

}

