/* Адаптив для планшетов и мобильных */
@media (max-width: 1024px) {
    .credentials__grid {
        display: flex;
        /* Выстраиваем карточки в одну линию */
        overflow-x: auto;
        /* Включаем горизонтальный скролл */
        scroll-snap-type: x mandatory;
        /* "Примагничивание" карточек при скролле */
        gap: 20px;
        /* Расстояние между карточками */
        padding: 20px 0;
        /* Отступы сверху и снизу, чтобы тени не обрезались */

        /* Скрываем стандартную полосу прокрутки для красоты */
        scrollbar-width: none;
        /* Для Firefox */
    }

    .credentials__grid::-webkit-scrollbar {
        display: none;
        /* Для Chrome, Safari, Edge */
    }

    .credential-card {
        flex: 0 0 280px;
        /* Фиксируем ширину карточки, чтобы она не сжималась */
        scroll-snap-align: start;
        /* Карточка будет прилипать к левому краю */
    }
}

/* Уточнения для маленьких экранов */
@media (max-width: 425px) {
    .credentials__grid {
        gap: 15px;
        /* Чуть меньше расстояние на телефонах */
        padding-left: 20px;
        /* Чтобы первая карточка не прилипала к краю экрана */
    }

    .credential-card {
        flex: 0 0 260px;
        /* На мобилках делаем карточки чуть уже */
    }
}

@media (max-width: 1024px) {

    /* 1. Убираем ограничение ширины контейнера, если оно есть */
    .faq-container {
        width: 100%;
        padding: 0 20px;
        /* Отступы по бокам, чтобы текст не прилипал */
        box-sizing: border-box;
    }

    /* 2. Стили для самого аккордеона */
    .faq-item {
        border-bottom: 1px solid #E0E0E0;
        /* Линия-разделитель как на скрине */
        padding: 20px 0;
    }

    /* 3. Оформление заголовка вопроса */
    .faq-item summary {
        display: flex;
        justify-content: space-between;
        align-items: center;
        list-style: none;
        /* Убираем стандартную стрелочку браузера */
        cursor: pointer;
        font-weight: 600;
        font-size: 16px;
    }

    /* Убираем стандартный маркер в Safari */
    .faq-item summary::-webkit-details-marker {
        display: none;
    }

    /* 4. Стили для вашей иконки (кружок со стрелочкой) */
    .faq-item .icon {
        width: 32px;
        height: 32px;
        background: #F4F7F9;
        /* Светлый фон кружка */
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: transform 0.3s ease;
    }

    /* Поворот стрелочки при открытии */
    .faq-item[open] .icon {
        transform: rotate(180deg);
    }

    /* 5. Контент ответа */
    .faq-content {
        padding-top: 15px;
        color: #5F6368;
        line-height: 1.6;
        font-size: 14px;
    }
}

@media (max-width: 425px) {
    .faq-container {
        padding: 0 15px;
        /* На очень узких экранах отступы чуть меньше */
    }

    .faq-item summary {
        font-size: 15px;
        /* Чуть уменьшаем шрифт заголовка */
    }
}